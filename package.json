{
  "name": "@affonso/cli",
  "version": "0.1.0",
  "description": "Command line interface for the Affonso affiliate marketing platform",
  "bin": {
    "affonso": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@affonso/sdk": "^0.1.0",
    "commander": "^12.0.0",
    "open": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "affonso",
    "affiliate",
    "cli"
  ],
  "license": "MIT"
}
